{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lidscape",
  "version": "0.1.0",
  "identifier": "se.sandstream.lidscape",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Lidscape",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'wasm-unsafe-eval' blob:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:8787 https://cdn.jsdelivr.net https://storage.googleapis.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; worker-src 'self' blob:; media-src 'self' blob: mediastream:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "category": "Entertainment",
    "shortDescription": "En pop-up-stad bakom skärmen",
    "externalBin": ["binaries/lid-bridge"],
    "macOS": {
      "minimumSystemVersion": "14.4",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
